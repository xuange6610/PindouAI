APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
KEY_ENCRYPTION_SECRET=replace-with-a-separate-strong-secret
MYSQL_DATABASE=ai_platform
MYSQL_USER=ai_platform
MYSQL_PASSWORD=replace-this-password
MYSQL_ROOT_PASSWORD=replace-this-root-password
DATABASE_URL=mysql+asyncmy://ai_platform:replace-this-password@mysql:3306/ai_platform?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
CORS_ORIGINS=["http://localhost:8080"]
